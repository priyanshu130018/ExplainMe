# ==========================================
# ExplainMe - Environment Configuration
# ==========================================

# Application
APP_NAME=ExplainMe
APP_ENV=development
API_V1_PREFIX=/api/v1
PORT=8000
DEBUG=true

# Database (Neon PostgreSQL)
# Example: postgresql+psycopg://user:password@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/explainme

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI & LLM Providers
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# Speech-to-Text Providers (Fallback Path)
SARVAM_API_KEY=your_sarvam_api_key_here
WHISPER_MODEL=base

# Embeddings & Vector Store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ENABLE_PGVECTOR=true

# Security / Auth (Future Expansion)
AUTH_SECRET=your_super_secret_auth_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
