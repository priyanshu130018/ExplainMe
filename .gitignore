# ==========================================
# ExplainMe .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL: NEVER COMMIT)
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/

# Node / Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Database & Runtime generated data
*.sqlite3
*.db
vector_db/
temp_audio/
temp_chunks/
.neon

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
